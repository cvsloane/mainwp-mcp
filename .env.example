# MainWP MCP Server Configuration
# =============================================================================
# Copy this file to .env.local and fill in your values.
# DO NOT commit .env.local to version control (it's already in .gitignore).
# =============================================================================

# -----------------------------------------------------------------------------
# REQUIRED SETTINGS
# -----------------------------------------------------------------------------

# MainWP Dashboard URL
# The full URL to your MainWP Dashboard WordPress installation
# Example: https://dashboard.myagency.com
# Example: https://my-mainwp-site.com/wp-admin (if installed in subdirectory)
MAINWP_DASHBOARD_URL=https://your-mainwp-dashboard.com

# MainWP REST API Key
# Format: consumer_key==consumer_secret (note the DOUBLE EQUALS SIGN)
# 
# How to generate:
# 1. Log into your MainWP Dashboard
# 2. Navigate to: MainWP → Settings → REST API
# 3. Click "Add API Key"
# 4. Set description (e.g., "Claude Code MCP")
# 5. Select permissions: Read + Write (for full management)
# 6. Click "Generate API Key"
# 7. COPY BOTH VALUES IMMEDIATELY - the secret is shown only once!
#
# Example: abc123def456...==xyz789uvw...
MAINWP_API_KEY=your_consumer_key==your_consumer_secret

# -----------------------------------------------------------------------------
# SAFETY SETTINGS (Recommended: Leave at defaults)
# -----------------------------------------------------------------------------

# Enable dry-run mode by default for all destructive operations
# When true, operations simulate first and show you what would happen
# You must explicitly confirm to apply changes
# Values: true | false
MAINWP_ENABLE_DRY_RUN_BY_DEFAULT=true

# Require explicit confirmation for bulk operations (multi-site)
# When true, operations affecting multiple sites require confirmation
# This prevents accidental mass-updates
# Values: true | false
MAINWP_REQUIRE_CONFIRMATION_BULK=true

# -----------------------------------------------------------------------------
# DEVELOPMENT SETTINGS (Optional)
# -----------------------------------------------------------------------------

# Test mode - simulate operations without making API calls
# Use this for development, demos, or smoke testing
# When true, mutating tools return simulated results and make no changes
# Values: true | false
MAINWP_TEST_MODE=false

# Rate limiting - maximum API requests per minute
# Prevents overwhelming your MainWP Dashboard server
# Adjust based on your infrastructure:
#   - Shared hosting: 30
#   - VPS: 60 (default)
#   - Dedicated server: 120
MAINWP_RATE_LIMIT_PER_MINUTE=60

# -----------------------------------------------------------------------------
# TROUBLESHOOTING
# -----------------------------------------------------------------------------

# Connection issues?
# 1. Verify MAINWP_DASHBOARD_URL is accessible in a browser
# 2. Check that the REST API is enabled in MainWP settings
# 3. Ensure your API key has the correct permissions
# 4. Verify the format: key==secret (double equals)

# Permission errors?
# - Regenerate your API key with Read + Write permissions
# - Check that your MainWP user has admin privileges

# Still stuck?
# - Enable test mode to verify the MCP server works
# - Check the README.md troubleshooting section
# - Review MainWP REST API documentation
# -----------------------------------------------------------------------------
